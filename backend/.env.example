# Copy to .env and fill in real values.

# --- Required ---
# Local dev default shown; when running via docker-compose this is overridden
# automatically to point at the "postgres" service, so you don't need to edit it
# for Docker use — it only matters if you run the backend directly on your host.
DATABASE_URL=postgresql://postgres:password@localhost:5432/cold_email_db

# Redis is required for Celery background tasks. Local dev default shown;
# docker-compose overrides this automatically to point at the "redis" service.
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Regex of allowed origins. Default allows any localhost/127.0.0.1 port (dev).
# For a real deployment, set this to your actual frontend origin, e.g.:
# CORS_ORIGIN_REGEX=https://app\.yourdomain\.com
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# --- Groq (AI research / qualification / email writing) ---
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# --- Gmail (sending emails) — OAuth2 refresh-token flow, no credentials file needed ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# --- Qualification thresholds (optional, defaults shown) ---
MIN_QUALIFICATION_CONFIDENCE=30
AUTO_APPROVE_CONFIDENCE_THRESHOLD=70
